<Project Sdk="Microsoft.NET.Sdk">

  <!-- Reads a running .NET program's memory from a Windows snapshot of it, through Microsoft's ClrMD and the program's own
       memory-reading library (its DAC). Read-only: it never writes to the program. The kit's one C# package reference
       (owner's yes, 20 November 2026): ClrMD, MIT, pinned here and listed in THIRD_PARTY_NOTICES.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Phobos.ModKit.Heap</RootNamespace>
    <AssemblyName>PhobosModKit.Heap</AssemblyName>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.2.751201" />
  </ItemGroup>

</Project>
